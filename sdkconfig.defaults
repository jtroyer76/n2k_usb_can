CONFIG_IDF_TARGET="esp32s3"

# AtomS3 Lite: ESP32-S3FN8, 8 MB flash, no PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Two OTA slots from day one so a later WiFi/web update path needs no USB reflash
CONFIG_PARTITION_TABLE_TWO_OTA=y

# TinyUSB: vendor interface (gs_usb) plus one CDC-ACM console. Vendor FIFOs
# disabled (size 0) so each bulk transfer carries exactly one gs_host_frame,
# as the gs_usb driver expects.
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_EPSIZE=64
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# The native USB PHY belongs to TinyUSB. Boot logs go to UART0 (not exposed
# on the AtomS3 Lite); once USB is up, logs move to the CDC console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 1 ms tick: the USB path waits in ~2 ms steps
CONFIG_FREERTOS_HZ=1000
