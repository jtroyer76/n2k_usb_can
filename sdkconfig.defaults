CONFIG_IDF_TARGET="esp32s3"

# AtomS3 Lite: ESP32-S3FN8, 8 MB flash, no PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Dual-OTA partition table (ota_0/ota_1/otadata) sized for a WiFi image, plus
# bootloader rollback: a freshly-OTA'd image boots pending-verify and reverts
# unless it marks itself valid (see ota_health.c). Firmware updates go over
# WiFi, no USB reflash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# TinyUSB: single vendor interface (gs_usb), no CDC. Vendor FIFOs disabled
# (size 0) so each bulk transfer carries exactly one gs_host_frame, as the
# gs_usb driver expects. The CDC-ACM console was removed to shrink the USB
# surface after a field wedge; diagnostics move to WiFi (v2).
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_EPSIZE=64
CONFIG_TINYUSB_CDC_ENABLED=n

# The native USB PHY belongs to TinyUSB. Logs go to UART0 (not exposed on the
# AtomS3 Lite, so effectively discarded) and never touch the USB stack.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 1 ms tick: the USB path waits in ~2 ms steps
CONFIG_FREERTOS_HZ=1000
